# AWS Academy Learner Lab: use us-east-1. Conta própria pode usar sa-east-1.
aws_region   = "us-east-1"
project_name = "tech-challenge"
environment  = "homolog"

db_infra_state_bucket = "SEU-BUCKET-DE-STATE"
db_infra_state_key    = "db-infra/homolog/terraform.tfstate"
db_infra_state_region = "us-east-1"

# Academy: voclabs nao permite CreateRole. Deixe null para auto (*LabEksClusterRole* / *LabEksNodeRole*).
# eks_cluster_role_name = "nome-exato-da-role-no-console"
# eks_node_role_name    = "nome-exato-da-role-no-console"

kubernetes_version  = "1.31"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4

# auth_lambda_invoke_arn: deixe vazio — /auth é criado pelo Terraform do auth-lambda.
# core_nlb_listener_arn: deixe vazio para discovery automático (tag kubernetes.io/service-name=tech-challenge/core).
# Override só se precisar forçar o ARN do listener TCP 8080:
# core_nlb_listener_arn = "arn:aws:elasticloadbalancing:..."
