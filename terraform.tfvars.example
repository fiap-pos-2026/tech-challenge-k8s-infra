aws_region   = "sa-east-1"
project_name = "tech-challenge"
environment  = "homolog"

db_infra_state_bucket = "fiap-soat3-terraform-state"
db_infra_state_key    = "db-infra/homolog/terraform.tfstate"
db_infra_state_region = "sa-east-1"

kubernetes_version  = "1.31"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4

# Preencher após o deploy do auth-lambda e do NLB da app:
